# Leave these blank to run in preview mode (data stored in your browser only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — used to create dealership logins. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# New-request emails (optional). Get a key at resend.com.
RESEND_API_KEY=
# Who gets the emails; separate several addresses with commas.
NOTIFY_EMAIL=
# Sender. Leave blank to use Resend's test sender, which can only email your own Resend account address.
# After verifying your domain in Resend, use e.g.: Leading Edge Dashboard <dashboard@leadingedgeaviationdetail.com>
NOTIFY_FROM=

# Shows "Sign in with Google" once the Google provider is set up in Supabase.
NEXT_PUBLIC_GOOGLE_SIGN_IN=
